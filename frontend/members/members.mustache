<div class="control-table mb-4">
    <div class="control-table-header p-4 mb-4 bck-second">
        <h1>Пользователи</h1>
        <div class="control-table-buttons">
            <button
                data-modal-open="add-user-modal"
                title="добавить пользователя"
                class="control-table-button def-button flex-basic px-2"
            >🗿</button>
        </div>
    </div>
    <table id="users-table">
        <thead>
            <tr>
                <th class="p-4">Логин</th>
                <th class="p-4">Управление</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
<div class="control-table mb-4">
    <div class="control-table-header p-4 mb-4 bck-second">
        <h1>Группы</h1>
        <div class="control-table-buttons">
            <button
                data-modal-open="add-group-modal"
                title="добавить группу"
                class="control-table-button def-button flex-basic px-2"
            >🧑‍🤝‍🧑</button>
        </div>
    </div>
    <table id="groups-table">
        <thead>
            <tr>
                <th class="p-4">Название</th>
                <th class="p-4">Владелец</th>
                <th class="p-4">Пользователи</th>
                <th class="p-4">Управление</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<div data-modal="add-user-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header p-2 mb-4">Создать пользователя</div>
        <form id="add-user-form" class="modal-body p-2 form">
            <label class="mb-4">
                <input class="p-2" type="text" name="username" placeholder="логин" value="">
            </label>
            <label class="mb-4">
                <input class="p-2" type="text" name="password" placeholder="пароль" value="">
            </label>
            <button type="submit" class="p-2">Создать</button>
        </form>
    </div>
</div>

<div data-modal="add-group-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header p-2 mb-4">Создать группу</div>
        <form id="add-group-form" class="modal-body p-2 form">
            <label class="mb-4">
                <input class="p-2" type="text" name="groupname" placeholder="название" value="">
            </label>
            <button type="submit" class="p-2">Создать</button>
        </form>
    </div>
</div>

<link rel="stylesheet" href="/static/members/members.css">
<script src="/public/default/default.js"></script>
<script src="/static/members/members.js"></script>

<script>
    let users = []
    let groups = []

    Promise.all([fetch_users(''), fetch_groups('','')]).then(values => {
        users = values[0]
        groups = values[1]

        render_users(users, "#users-table tbody")
        render_groups(groups, users, "#groups-table tbody")
    })

    document.querySelector("#add-user-form").addEventListener('submit', e => {
        e.preventDefault()

        const form = e.target

        const name = form.querySelector("[name='username']").value
        const password = form.querySelector("[name='password']").value

        create_user(name, password)
            .then(res => {
                if (res === true)
                    window.location.reload()

                alert(res)
            })
    })

    document.querySelector("#add-group-form").addEventListener('submit', e => {
        e.preventDefault()

        const form = e.target
        const group_name = form.querySelector("[name='groupname']").value

        create_group(group_name, "root")
            .then(res => {
                if (res) window.location.reload()
                alert(res)
            })
    })

    document.addEventListener('click', e => {
        if (e.target.hasAttribute('data-user-remove')) {
            const user_name = e.target.getAttribute('data-user-remove')
            delete_user(user_name).then(res => {
                if (res === true)
                    window.location.reload()
            })
        }


        if (e.target.hasAttribute('data-group-remove')) {
            const group_name = e.target.getAttribute('data-group-remove')

            delete_group(group_name).then(res => {
                if (res === true)
                    window.location.reload()
            })
        }

        if (e.target.hasAttribute('data-group-save')) {
            const parent = e.target.closest('tr')
            const members = parent.querySelectorAll('[data-member-input]:checked')
            const new_members = []

            const group_name = e.target.getAttribute('data-group-save')
            const owner = parent.querySelector('[data-owner-input]:checked').value

            if (members.length > 0) {
                members.forEach(item => new_members.push(item.value))
            }

            update_group(group_name, "", owner, new_members).then(res => {
                if (res.name === group_name) window.location.reload()
            })
        }
    })

    modals()
</script>
