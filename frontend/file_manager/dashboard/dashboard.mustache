<div class="manager-grid" data-dir-id="{{dir_id}}">
    <div class="manager-grid-header p-2">
        {{#dir_id}}
        <a href="{{#parent_id}}/dashboard/directory/{{parent_id}}{{/parent_id}}{{^parent_id}}/dashboard/root{{/parent_id}}" class="manager-button def-button flex-basic px-2" id="back-btn">
            Назад
        </a>
        {{/dir_id}}
        <button
            title="добавить директорию"
            class="manager-button def-button flex-basic px-2"
            data-modal-open="add-dir-modal"
        >📁</button>
        <button
            title="добавить файл"
            class="manager-button def-button flex-basic px-2"
            data-modal-open="add-file-modal"
        >📄</button>
    </div>
    <div id="manager-grid" class="manager-grid-content"></div>
</div>

<div data-modal="add-dir-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header p-2 mb-4">
            Добавить директорию
        </div>
        <form id="add-dir-form" class="modal-body p-2 form">
            <input type="hidden" name="parent_id" value="{{dir_id}}">
            <label class="mb-4">
                <input
                    class="p-2"
                    type="text"
                    name="name"
                    placeholder="имя директории"
                    value=""
                    autocomplete="off"
                >
            </label>
            <button type="submit" class="p-2">Создать</button>
        </form>
    </div>
</div>

<div data-modal="add-file-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header p-2 mb-4">
            Добавить файл
        </div>
        <form id="add-file-form" class="modal-body p-2 form">
            <input type="hidden" name="parent_id" value="{{dir_id}}">
            <label class="mb-4">
                <input
                    class="p-2"
                    type="text"
                    name="name"
                    placeholder="имя файла"
                    value=""
                    autocomplete="off"
                >
            </label>
            <button type="submit" class="p-2">Создать</button>
        </form>
    </div>
</div>

<link rel="stylesheet" href="/static/file_manager/dashboard/dashboard.css">
<script src="/public/default/default.js"></script>
<script type="module">
    import {
    mk_manager_item,
    mk_file_manager,
    append_item,
    make_item_html,
    } from "/static/file_manager/dashboard/file_manager.js"

    document.addEventListener("DOMContentLoaded", (e) => {
        const add_directory_form = document.querySelector("#add-dir-form")
        const add_file_form = document.querySelector("#add-file-form")
        const dir_id = document.querySelector('.manager-grid').dataset.dirId;

        const get_username = () => (fetch_user_data().username || "")

        const remove_node = (id) => {
            return send_delete("/node/" + id)
        };

        const type_map = { directory: "dir", text_file: "text_file" }

        const map_item = (item) => {
            return mk_manager_item(
                item.id,
                type_map[item.value.type] || "broken",
                "",
                item.value.content.name,
                item.permitions.owner,
                item.permitions.group,
            )
        }

        const fetch_content = () => {
            const params = dir_id ? { parent_id: dir_id } : { parent_id: "root" }
            return send_get("/nodes", params)
                .then(res => mk_file_manager(res.map(map_item)))
        };

        const show_file_manager = (html) => {
            const parent = document.querySelector("#manager-grid");
            parent.innerHTML = "";
            parent.insertAdjacentHTML("beforeend", html);

            let remove_node_buttons = document.querySelectorAll("[data-node-remove]");

            remove_node_buttons.forEach((node) => {
            node.addEventListener("click", (e) => {
                const id = e.target.closest(".file-item").getAttribute("data-id");

                    remove_node(id).then((res) => {
                        file_manager = fetch_content().then((fm) => {
                            show_file_manager(fm.items.map(make_item_html).join(""))
                            return fm
                        }).catch(err => {
                            if (err && err.status === 400) return;
                            throw err;
                        });
                    }).catch(err => alert(err.message));
                });
            });
        };

        let file_manager = fetch_content().then((fm) => {
            show_file_manager(fm.items.map(make_item_html).join(""));
            return fm;
        }).catch(err => {
            if (err && err.status === 400) return;
            throw err;
        });

        add_directory_form.addEventListener("submit", e => {
            e.preventDefault()

            const form_data = new FormData(e.target)
            const json_object = Object.fromEntries(form_data.entries())
            json_object.owner = get_username()
            json_object.group = "root"
            json_object.permissions = "rwr-"

            send_post("/node/directory", json_object).then((_) => {
                file_manager = fetch_content().then((fm) => {
                    show_file_manager(fm.items.map(make_item_html).join(""))
                    close_modals()
                    return fm
                }).catch(err => {
                    if (err && err.status === 400) return;
                    throw err;
                })
            }).catch(err => alert(err.message))
        })

        add_file_form.addEventListener("submit", e => {
            e.preventDefault()

            const form_data = new FormData(e.target)
            const json_object = Object.fromEntries(form_data.entries())
            json_object.content = ""
            json_object.owner = get_username()
            json_object.group = "root"
            json_object.permissions = "rwr-"

            send_post("/node/text_file", json_object).then(() => {
                file_manager = fetch_content().then((fm) => {
                    show_file_manager(fm.items.map(make_item_html).join(""))
                    close_modals()
                    return fm
                }).catch(err => {
                    if (err && err.status === 400) return;
                    throw err;
                })
            }).catch(err => alert(err.message))
        })
    })

    modals()
</script>
