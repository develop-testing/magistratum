<div class="manager-grid" data-dir-id="{{dir_id}}">
    <div class="manager-grid-header p-2">
        {{#dir_id}}
        <a href="{{#parent_id}}/dashboard/directory/{{parent_id}}{{/parent_id}}{{^parent_id}}/dashboard/root{{/parent_id}}" class="manager-button def-button flex-basic px-2" id="back-btn">
            Назад
        </a>
        {{/dir_id}}
        <button
            title="добавить директорию"
            class="manager-button def-button flex-basic px-2"
            data-modal-open="add-dir-modal"
        >📁</button>
        <button
            title="добавить файл"
            class="manager-button def-button flex-basic px-2"
            data-modal-open="add-file-modal"
        >📄</button>
    </div>
    <div id="manager-grid" class="manager-grid-content"></div>
</div>

<div data-modal="add-dir-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header p-2 mb-4">
            Добавить директорию
        </div>
        <form id="add-dir-form" class="modal-body p-2 form">
            <input type="hidden" name="parent_id" value="{{dir_id}}">
            <label class="mb-4">
                <input
                    class="p-2"
                    type="text"
                    name="name"
                    placeholder="имя директории"
                    value=""
                    autocomplete="off"
                >
            </label>
            <button type="submit" class="p-2">Создать</button>
        </form>
    </div>
</div>

<div data-modal="add-file-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header p-2 mb-4">
            Добавить файл
        </div>
        <form id="add-file-form" class="modal-body p-2 form">
            <input type="hidden" name="dir_id" value="{{dir_id}}">
            <label class="mb-4">
                <input
                    class="p-2"
                    type="text"
                    name="filename"
                    placeholder="имя файла"
                    value=""
                    autocomplete="off"
                >
            </label>
            <button type="submit" class="p-2">Создать</button>
        </form>
    </div>
</div>

<link rel="stylesheet" href="/static/file_manager/dashboard/dashboard.css">
<script src="/public/default/default.js"></script>
<script type="module">
    import {
    mk_manager_item,
    mk_file_manager,
    append_item,
    make_item_html,
    } from "/static/file_manager/dashboard/file_manager.js"

    document.addEventListener("DOMContentLoaded", (e) => {
        const add_directory_form = document.querySelector("#add-dir-form")
        const add_file_form = document.querySelector("#add-file-form")
        const dir_id = document.querySelector('.manager-grid').dataset.dirId;

        const remove_directory = (id) => {
            return send_delete("/directory", { dir_id: id })
        };

        const remove_text_file = (id) => {
            return send_delete("/file", { file_id: id })
        };

        const map_rich_dir = (item) => {
            if (item.reason) {
                return mk_manager_item("", "broken", "/public/img/not-found.png", item.name, "", "")
            }
            return mk_manager_item(
                item.directory.dir_id,
                "dir",
                item.image,
                item.directory.name,
                item.perms.owner_name,
                item.perms.group_name,
            )
        }

        const map_rich_file = (item) => {
            if (item.reason) {
                return mk_manager_item("", "broken", "/public/img/not-found.png", item.name, "", "")
            }
            return mk_manager_item(
                item.text_file.file_id,
                "text_file",
                item.image,
                item.text_file.name,
                item.perms.owner_name,
                item.perms.group_name,
            )
        }

        const fetch_root_content = () => {
            return send_get("/directories/root")
                .then(res => {
                    return mk_file_manager(res.map(map_rich_dir))
                })
        };

        const fetch_directory_content = () => {
            return Promise.all([
                send_get("/directories", { parent_id: dir_id, data_type: "rich" }),
                send_get("/files", { by_directory: dir_id, data_type: "rich", limit: 0 }),
            ]).then(([dirs, files]) => {
                return mk_file_manager([
                    ...dirs.map(map_rich_dir),
                    ...files.map(map_rich_file),
                ])
            })
        };

        const get_content = dir_id ? fetch_directory_content : fetch_root_content;

        const show_file_manager = (html) => {
            const parent = document.querySelector("#manager-grid");
            parent.innerHTML = "";
            parent.insertAdjacentHTML("beforeend", html);

            let remove_node_buttons = document.querySelectorAll("[data-node-remove]");

            remove_node_buttons.forEach((node) => {
            node.addEventListener("click", (e) => {
                const type = e.target.closest(".file-item").getAttribute("data-type");
                const id = e.target.closest(".file-item").getAttribute("data-id");

                let result =
                    type === "dir" ? remove_directory(id) : remove_text_file(id);

                    result.then((res) => {
                        file_manager = get_content().then((fm) => {
                            show_file_manager(fm.items.map(make_item_html).join(""));
                            return fm;
                        }).catch(err => {
                            if (err && err.status === 400) return;
                            throw err;
                        });
                    });
                });
            });
        };

        let file_manager = get_content().then((fm) => {
            show_file_manager(fm.items.map(make_item_html).join(""));
            return fm;
        }).catch(err => {
            if (err && err.status === 400) return;
            throw err;
        });

        add_directory_form.addEventListener("submit", e => {
            e.preventDefault()

            const form_data = new FormData(e.target)
            const json_object = Object.fromEntries(form_data.entries())

            send_post("/directory", json_object).then((_) => {
                file_manager = get_content().then((fm) => {
                    show_file_manager(fm.items.map(make_item_html).join(""))
                    return fm;
                }).catch(err => {
                    if (err && err.status === 400) return;
                    throw err;
                })
            })
        })

        add_file_form.addEventListener("submit", e => {
            e.preventDefault()

            const form_data = new FormData(e.target)
            const json_object = Object.fromEntries(form_data.entries())
            json_object.content = ""

            send_post("/file", json_object).then(() => {
                file_manager = get_content().then((fm) => {
                    show_file_manager(fm.items.map(make_item_html).join(""))
                    return fm
                }).catch(err => {
                    if (err && err.status === 400) return;
                    throw err;
                })
            })
        })
    })

    modals()
</script>
