<div class="manager-grid" data-dir-id="{{dir_id}}">
    <div class="manager-grid-header">
        {{#parent_id}}
        <a href="/dashboard/directory/{{parent_id}}" class="manager-button">
            Назад
        </a>
        {{/parent_id}}
        <button
            title="добавить директорию"
            class="manager-button"
            data-modal-open="add-dir-modal"
        >📁</button>
        <button
            title="добавить файл"
            class="manager-button"
            data-modal-open="add-file-modal"
        >📄</button>
    </div>
    <div id="manager-grid" class="manager-grid-content"></div>
</div>

<div data-modal="add-dir-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            Добавить директорию
        </div>
        <form id="add-dir-form" class="modal-body form">
            <input type="hidden" name="parent_id" value="{{dir_id}}">
            <label>
                <input
                    type="text"
                    name="name"
                    placeholder="имя директории"
                    value=""
                    autocomplete="off"
                >
            </label>
            <button type="submit">Создать</button>
        </form>
    </div>
</div>

<div data-modal="add-file-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            Добавить файл
        </div>
        <form id="add-file-form" class="modal-body form">
            <input type="hidden" name="dir_id" value="{{dir_id}}">
            <label>
                <input
                    type="text"
                    name="filename"
                    placeholder="имя файла"
                    value=""
                    autocomplete="off"
                >
            </label>
            <button type="submit">Создать</button>
        </form>
    </div>
</div>

<script src="/public/default/common.js"></script>
<script type="module">
    import {
    mk_manager_item,
    mk_file_manager,
    append_item,
    make_item_html,
    } from "/static/file_manager/dashboard/file_manager.js"

    document.addEventListener("DOMContentLoaded", (e) => {
        const add_directory_form = document.querySelector("#add-dir-form")
        const add_file_form = document.querySelector("#add-file-form")

        const remove_directory = (id) => {
            return send_delete("/directory", { dir_id: id })
        };

        const remove_text_file = (id) => {
            return send_delete("/file", { file_id: id })
        };

        const fetch_directory_content = () => {
            return send_get("/directory/content", { dir_id: dir_id })
                .then(res => {
                    return mk_file_manager([
                    ...res.map((item) =>
                        mk_manager_item(
                        item.node.node_id,
                        item.node.type,
                        item.meta.img,
                        item.meta.name,
                        item.perms.owner_name,
                        item.perms.group_name,
                        ),
                    ),
                    ]);
                });
        };

        const show_file_manager = (html) => {
            const parent = document.querySelector("#manager-grid");
            parent.innerHTML = "";
            parent.insertAdjacentHTML("beforeend", html);

            let remove_node_buttons = document.querySelectorAll("[data-node-remove]");

            remove_node_buttons.forEach((node) => {
            node.addEventListener("click", (e) => {
                const type = e.target.closest(".file-item").getAttribute("data-type");
                const id = e.target.closest(".file-item").getAttribute("data-id");

                let result =
                    type === "dir" ? remove_directory(id) : remove_text_file(id);

                    result.then((res) => {
                        file_manager = fetch_directory_content().then((fm) => {
                            show_file_manager(fm.items.map(make_item_html).join(""));
                            return fm;
                        });
                    });
                });
            });
        };

        const dir_id = document.querySelector('.manager-grid').dataset.dirId;

        let file_manager = fetch_directory_content().then((fm) => {
            show_file_manager(fm.items.map(make_item_html).join(""));
            return fm;
        });

        add_directory_form.addEventListener("submit", e => {
            e.preventDefault()

            const form_data = new FormData(e.target)
            const json_object = Object.fromEntries(form_data.entries())

            send_post("/directory", json_object).then((_) => {
                file_manager = fetch_directory_content().then((fm) => {
                    show_file_manager(fm.items.map(make_item_html).join(""))
                    return fm;
                })
            })
        })

        add_file_form.addEventListener("submit", e => {
            e.preventDefault()

            const form_data = new FormData(e.target)
            const json_object = Object.fromEntries(form_data.entries())
            json_object.content = ""

            send_post("/file", json_object).then(() => {
                file_manager = fetch_directory_content().then((fm) => {
                    show_file_manager(fm.items.map(make_item_html).join(""))
                    return fm
                })
            })
        })
    })

    modals()
</script>
