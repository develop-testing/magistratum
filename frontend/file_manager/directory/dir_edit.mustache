<div class="editor-header p-2 mb-4">
    <div class="editor-header-content">
        <span class="editor-title">Редактировать директорию</span>
        <a class="def-button flex-basic px-2" id="back-btn" href="/dashboard/directory/">Назад</a>
        <button id="save-btn" class="editor-btn def-button flex-basic px-2">Сохранить</button>
    </div>
</div>
<div id="editor-card" class="editor-card tabs">
    <div class="tabs-header mb-4 flex-basic">
        <button data-tab="general" class="tabs-button def-button flex-basic px-2">Общее</button>
        <button data-tab="perms" class="tabs-button def-button flex-basic px-2">Доступ</button>
        <button data-tab="meta" class="tabs-button def-button flex-basic px-2">Мета</button>
    </div>
    <div class="tabs-body">
        <div data-tab-content="general" class="tabs-content active">
            <input type="hidden" name="file-id" value="{{file_id}}">
            <input type="hidden" name="editor" value="{{editor}}">
            <label class="def-field mb-4">
                <span class="mb-2">Название</span>
                <input class="p-1" name="file-name" value="">
            </label>
        </div>
        <div data-tab-content="perms" class="tabs-content">
            <label class="def-field mb-4">
                <span class="mb-2">Родительская директория</span>
                <select class="p-1" name="perm-parent-dir"></select>
            </label>
            <label class="def-field mb-4">
                <span class="mb-2">Владелец</span>
                <select class="p-1" name="perm-owner"></select>
            </label>
            <label class="def-field mb-4">
                <span class="mb-2">Группа</span>
                <select class="p-1" name="perm-group-name"></select>
            </label>
            <label class="def-field mb-4">
                <span class="mb-2">Права Группы</span>
                <select class="p-1" name="perm-group-perms"></select>
            </label>
            <label class="def-field mb-4">
                <span class="mb-2">Права Остальных</span>
                <select class="p-1" name="perm-other-perms"></select>
            </label>
        </div>
        <div data-tab-content="meta" class="tabs-content">
            <div class="def-field mb-4">
                <span class="mb-2">Текущее изображение</span>
                <img class="h-24" name="image-preview" src="">
            </div>
            <label class="def-field mb-4">
                <span class="mb-2">Изображение</span>
                <input class="p-1" type="file" name="image" accept="image/*">
            </label>
        </div>
    </div>
</div>

<script src="/public/default/default.js"></script>
<script src="/static/file_manager/directory/edit_dir.js"></script>
<script>
    tabs("[data-tab]", "[data-tab-content]")

    const save_btn = document.querySelector("#save-btn")
    const edit_card = document.querySelector("#editor-card")
    const dir_id = window.location.pathname.split('/').pop()

    let dir_edit_form = mk_dir_edit_form({})

    fetch_directory(dir_id)
        .then(data => mk_dir_edit_form(data))
        .then(form => {
            dir_edit_form = render_dir_edit_form(form)
        })

    edit_card.addEventListener('change', e => {
        const target = e.target
        const name = target.name

        if (name === "file-name")
            dir_edit_form = change_dir_edit_form(dir_edit_form, "title", target.value)

        if (name === "perm-parent-dir")
            dir_edit_form = change_dir_edit_form(dir_edit_form, "parent", target.value)

        if (name === "perm-owner")
            dir_edit_form = change_dir_edit_form(dir_edit_form, "owner", target.value)

        if (name === "perm-group-name")
            dir_edit_form = change_dir_edit_form(dir_edit_form, "group", target.value)

        if (name === "perm-group-perms")
            dir_edit_form = change_dir_edit_form(dir_edit_form, "group-perms", target.value)

        if (name === "perm-other-perms")
            dir_edit_form = change_dir_edit_form(dir_edit_form, "other-perms", target.value)

        if (name === "image")
            dir_edit_form = render_dir_image(
                change_dir_edit_form(dir_edit_form, "image", target.files)
            )
    })

    save_btn.addEventListener('click', e => {
        save_dir_edit_form(dir_edit_form, dir_id)
            .then(() => alert("Сохранено успешно"))
            .catch(() => alert("Ошибка при сохранении"))
    })
</script>
