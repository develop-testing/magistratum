<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>{{title}}</title>
        <style>{{{styles}}}</style>
        <link rel="stylesheet" href="/static/file_manager/detail_file/tinymce/skins/ui/oxide/skin.min.css">
    </head>
    <body data-file-id="{{file_id}}" data-parent-id="{{parent_id}}">
        <header class="header">
            <div class="header-content">{{title}}</div>
        </header>
        <main class="main">
            <div class="main-content editor">
                <div class="editor-header">
                    <div class="editor-header-content">
                        <span class="editor-title">Редактировать статью</span>
                        <a href="/text_file/{{file_id}}" class="editor-btn">Читать</a>
                        <button id="save-btn" class="editor-btn">Сохранить</button>
                    </div>
                </div>
                <div class="editor-card tabs">
                    <div class="tabs-header">
                        <button data-tab="general" class="tabs-button def-button">Общее</button>
                        <button data-tab="perms" class="tabs-button def-button">Доступ</button>
                        <button data-tab="meta" class="tabs-button def-button">Мета</button>
                    </div>
                    <div class="tabs-body">
                        <div data-tab-content="general" class="tabs-content active">
                            <label class="def-field">
                                <span>Название</span>
                                <input name="file-name" value="">
                            </label>
                            <div class="editor-body">
                                <textarea id="editor"></textarea>
                            </div>
                        </div>
                        <div data-tab-content="perms" class="tabs-content">
                            <label class="def-field">
                                <span>Родительская директория</span>
                                <select name="perm-parent-dir">
                                    {{#all_dirs}}
                                    <option
                                        value="{{dir_id}}"
                                        {{#is_current}}selected{{/is_current}}
                                    > {{name}} </option>
                                    {{/all_dirs}}
                                </select>
                            </label>
                            <label class="def-field">
                                <span>Владелец</span>
                                <select name="perm-owner">
                                    {{#all_users}}
                                    <option value="{{name}}" {{#is_current}}selected{{/is_current}}>{{name}}</option>
                                    {{/all_users}}
                                </select>
                            </label>
                            <label class="def-field">
                                <span>Группа</span>
                                <select name="perm-group-name">
                                    {{#all_groups}}
                                    <option value="{{name}}" {{#is_current}}selected{{/is_current}}>{{name}}</option>
                                    {{/all_groups}}
                                </select>
                            </label>
                            <label class="def-field">
                                <span>Права Группы</span>
                                <select name="perm-group-perms">
                                    <option value="r" {{#is_group_r}}selected{{/is_group_r}}>Чтение</option>
                                    <option value="w" {{#is_group_w}}selected{{/is_group_w}}>Запись</option>
                                    <option value="rw" {{#is_group_rw}}selected{{/is_group_rw}}>Чтение и запись</option>
                                </select>
                            </label>
                            <label class="def-field">
                                <span>Права Остальных</span>
                                <select name="perm-other-perms">
                                    <option value="r" {{#is_other_r}}selected{{/is_other_r}}>Чтение</option>
                                    <option value="w" {{#is_other_w}}selected{{/is_other_w}}>Запись</option>
                                    <option value="rw" {{#is_other_rw}}selected{{/is_other_rw}}>Чтение и запись</option>
                                </select>
                            </label>
                        </div>
                        <div data-tab-content="meta" class="tabs-content">
                            <div class="def-field">
                                <span>Текущее изображение</span>
                                <img
                                    class="h-24"
                                    name="image-preview"
                                    src="{{image_url}}"
                                >
                            </div>
                            <label class="def-field">
                                <span>Изображение</span>
                                <input type="file" name="image" accept="image/*">
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </main>

    <script src="/static/file_manager/detail_file/tinymce/tinymce.min.js"></script>
    <script>
        const tabs = (btns_tags, tabs_tags) => {
            const tabs_buttons = document.querySelectorAll(btns_tags);
            const tabs = document.querySelectorAll(tabs_tags);

            tabs_buttons.forEach(button => {
                button.addEventListener('click', e => {
                    const tab_name = e.target.getAttribute("data-tab")
                    tabs.forEach(tab => {
                        if (tab_name !== tab.getAttribute("data-tab-content")) {
                            tab.classList.remove('active')
                        } else {
                            tab.classList.add('active')
                        }
                    })

                })
            })
        }

        tabs("[data-tab]", "[data-tab-content]")

        let page_data = {}

        const fetch_file_data = (file_id, username) => {
            const files_url = new URL('http://127.0.0.1:8800/files')
            files_url.searchParams.append('by_id', file_id)
            files_url.searchParams.append('data_type', 'rich')

            const groups_url = new URL('http://127.0.0.1:8800/groups')
            groups_url.searchParams.append('member', username)

            return Promise.all([
                fetch(files_url, {credentials: 'include'})
                    .then(res => res.json())
                    .then(item => {
                        return {
                            ...item[0].text_file,
                            ...item[0].perms,
                            image: item[0].image
                        }
                    }),
                fetch(groups_url, {credentials: 'include'})
                    .then(res => res.json())
            ]).then(res => {
                return {
                    file: res[0],
                    groups: res[1]
                }
            })
        }

        const init_editor = (editor_tag, value) => {
            return tinymce.init({
                selector: editor_tag,
                menubar: false,
                branding: false,
                promotion: false,
                height: "100%",
                plugins: "lists link image code fullscreen preview",
                toolbar: "bold italic | blocks | bullist numlist | link image | code fullscreen preview",
                content_style: "body { font-family: monospace; }",
                setup: function (editor) {
                    editor.on("init", function () {
                        editor.setContent(value || "")
                    })
                }
            })
        }

        const init_name = (name_tag, value) => {
            const name = document.querySelector(name_tag)
            name.value = value

            return name
        }

        const init_general = data => {
            init_editor("#editor", data.content)
            init_name("[name='file-name']", data.name)

            return data
        }

        const init_image = () => {

        }

        fetch_file_data(document.body.dataset.fileId, "root")
            .then(data => init_general(data.file))


