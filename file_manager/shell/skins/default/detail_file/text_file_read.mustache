<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>{{title}}</title>
        <style>{{{styles}}}</style>
    </head>
    <body>
        <header class="header">
            <div class="header-content">
                {{title}} — {{file_name}}
            </div>
        </header>
        <main class="main">
            <div class="main-content">
                <div class="editor-header">
                    <div class="editor-header-content">
                        <a href="/dashboard/directory/{{parent_id}}" class="editor-btn">Назад</a>
                        <a href="/text_file/edit/{{file_id}}" class="editor-btn">Редактировать</a>
                    </div>
                </div>
                <div class="article-card">
                    {{{file_content}}}
                </div>
            </div>
        </main>
    </body>
</html>
